# Copy this file to .env and fill in what you have. Everything is optional.

# Claude API key (console.anthropic.com). Without it the creature uses canned offline lines.
ANTHROPIC_API_KEY=

# Connect to this TikTok LIVE automatically on start (you can also connect from the test panel).
TIKTOK_USERNAME=

# Optional Euler Stream key for higher TikTok connection limits (eulerstream.com).
EULER_API_KEY=

PORT=3000
